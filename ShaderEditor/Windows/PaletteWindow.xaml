<Window x:Class="ShaderEditor.Windows.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palette-Funktion"
        Width="460"
        SizeToContent="Height"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#D4D4D4">
    <Window.Resources>
        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Margin" Value="0,2,8,2" />
            <EventSetter Event="ValueChanged" Handler="Slider_ValueChanged" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Parameter der palette-Funktion" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
        <TextBlock Grid.Row="1" Text="DC offset" FontWeight="Bold" Margin="0,0,0,4" />
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
            <TextBlock Text="R" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Value="{Binding AR, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding AR, StringFormat={}{0:F3}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" Value="{Binding AG, Mode=TwoWay}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AG, StringFormat={}{0:F3}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" />
            <Slider Grid.Row="2" Grid.Column="1" Value="{Binding AB, Mode=TwoWay}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding AB, StringFormat={}{0:F3}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      
        <TextBlock Grid.Row="3" Text="amplitude" FontWeight="Bold" Margin="0,0,0,4" />
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
            <TextBlock Text="R" VerticalAlignment="Center" /><Slider Grid.Column="1" Value="{Binding BR, Mode=TwoWay}" /><TextBlock Grid.Column="2" Text="{Binding BR, StringFormat={}{0:F3}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" /><Slider Grid.Row="1" Grid.Column="1" Value="{Binding BG, Mode=TwoWay}" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BG, StringFormat={}{0:F3}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" /><Slider Grid.Row="2" Grid.Column="1" Value="{Binding BB, Mode=TwoWay}" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BB, StringFormat={}{0:F3}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      

        <TextBlock Grid.Row ="5" Text="frequency" FontWeight="Bold" Margin="0,0,0,4" />
        <Grid Grid.Row="6">
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
            <TextBlock Text="R" /><Slider Grid.Column="1" Value="{Binding CR, Mode=TwoWay}" /><TextBlock Grid.Column="2" Text="{Binding CR, StringFormat={}{0:F3}}" HorizontalAlignment="Right" />
            <TextBlock Grid.Row="1" Text="G" /><Slider Grid.Row="1" Grid.Column="1" Value="{Binding CG, Mode=TwoWay}" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CG, StringFormat={}{0:F3}}" HorizontalAlignment="Right" />
            <TextBlock Grid.Row="2" Text="B" /><Slider Grid.Row="2" Grid.Column="1" Value="{Binding CB, Mode=TwoWay}" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CB, StringFormat={}{0:F3}}" HorizontalAlignment="Right" />
        </Grid>
      
        <TextBlock Grid.Row="7" Text="phase" FontWeight="Bold" Margin="0,8,0,4" />
        <Grid Grid.Row="8">
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
            <TextBlock Text="R" /><Slider Grid.Column="1" Value="{Binding DR, Mode=TwoWay}" /><TextBlock Grid.Column="2" Text="{Binding DR, StringFormat={}{0:F3}}" HorizontalAlignment="Right" />
            <TextBlock Grid.Row="1" Text="G" /><Slider Grid.Row="1" Grid.Column="1" Value="{Binding DG, Mode=TwoWay}" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DG, StringFormat={}{0:F3}}" HorizontalAlignment="Right" />
            <TextBlock Grid.Row="2" Text="B" /><Slider Grid.Row="2" Grid.Column="1" Value="{Binding DB, Mode=TwoWay}" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DB, StringFormat={}{0:F3}}" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="9" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="0,0" />
            <TextBlock Grid.Column="1" Text="1,0" HorizontalAlignment="Right" />
            <Border x:Name="PalettePreview" Grid.Row="1" Grid.ColumnSpan="2" Height="20" CornerRadius="2" />
        </Grid>
      
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" IsCancel="True" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="OK" IsDefault="True" Click="OkButton_Click" Padding="12,5" />
        </StackPanel>
    </Grid>
</Window>
