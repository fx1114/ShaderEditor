<Window x:Class="ShaderEditor.Windows.NewParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ISF-Parameter hinzufügen" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="#252526" Foreground="#D4D4D4"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Typ:" VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox x:Name="TypeComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="TypeComboBox_SelectionChanged" Margin="0,0,0,8">
            <ComboBoxItem Content="Float" Tag="float" />
            <ComboBoxItem Content="Boolean" Tag="bool" />
            <ComboBoxItem Content="Punkt 2D" Tag="point2D" />
            <ComboBoxItem Content="Farbe (RGBA)" Tag="color" />
        </ComboBox>

        <TextBlock Text="Name:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox x:Name="NameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Text="Label:" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox x:Name="LabelTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock x:Name="DefaultLabel" Text="Default:" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox x:Name="DefaultTextBox" Grid.Row="3" Grid.Column="1" Text="0.5" Margin="0,0,0,8" />

        <TextBlock x:Name="MinLabel" Text="Minimum:" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox x:Name="MinTextBox" Grid.Row="4" Grid.Column="1" Text="0" Margin="0,0,0,8" />

        <TextBlock x:Name="MaxLabel" Text="Maximum:" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox x:Name="MaxTextBox" Grid.Row="5" Grid.Column="1" Text="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Bei Punkt 2D und Farbe: Werte mit Semikolon trennen (z. B. 0;0 oder 1;1;1;1)." TextWrapping="Wrap" Foreground="#AAAAAA" Margin="0,0,0,12" />
        <TextBlock x:Name="ErrorTextBlock" Grid.Row="6" Grid.ColumnSpan="2" Foreground="#F48771" TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" IsCancel="True" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="Hinzufügen" IsDefault="True" Click="AddButton_Click" Padding="12,5" />
        </StackPanel>
    </Grid>
</Window>
