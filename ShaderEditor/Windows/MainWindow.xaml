<Window x:Class="ShaderEditor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:isf="clr-namespace:ShaderEditor.Isf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShaderEditor.Windows"
        mc:Ignorable="d"
        Title="ShaderEditor" Height="800" Width="1240" Background="#1E1E1E" Foreground="#D4D4D4"
        WindowStyle="None"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="24" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>
    
    <Window.Resources>
        <!-- Template für ISF "float" -> Slider + Zahlenwert -->
        <DataTemplate DataType="{x:Type isf:FloatParameterVm}">
            <StackPanel Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Value, StringFormat={}{0:F3}}" HorizontalAlignment="Right" Foreground="#9CDCFE" />
                </DockPanel>
                <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value, Mode=TwoWay}" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Template für ISF "bool" / "event" -> CheckBox -->
        <DataTemplate DataType="{x:Type isf:BoolParameterVm}">
            <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding Value, Mode=TwoWay}" 
                      Foreground="#D4D4D4" Margin="0,0,0,12" />
        </DataTemplate>

        <!-- Template für ISF "point2D" -> X/Y Slider -->
        <DataTemplate DataType="{x:Type isf:Point2DParameterVm}">
            <Border BorderBrush="#333333" BorderThickness="1" Padding="8" Margin="0,0,0,12" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DockPanel>
                        <TextBlock Text="X:" Width="20" />
                        <TextBlock Text="{Binding X, StringFormat={}{0:F2}}" DockPanel.Dock="Right" Width="35" TextAlignment="Right" />
                        <Slider Minimum="{Binding MinX}" Maximum="{Binding MaxX}" Value="{Binding X, Mode=TwoWay}" />
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Y:" Width="20" />
                        <TextBlock Text="{Binding Y, StringFormat={}{0:F2}}" DockPanel.Dock="Right" Width="35" TextAlignment="Right" />
                        <Slider Minimum="{Binding MinY}" Maximum="{Binding MaxY}" Value="{Binding Y, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Template für ISF "color" -> RGBA Slider -->
        <DataTemplate DataType="{x:Type isf:ColorParameterVm}">
            <Border BorderBrush="#333333" BorderThickness="1" Padding="8" Margin="0,0,0,12" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DockPanel>
                        <TextBlock Text="R:" Width="20" Foreground="#F48771"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding R, Mode=TwoWay}"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="G:" Width="20" Foreground="#89D185"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding G, Mode=TwoWay}"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="B:" Width="20" Foreground="#569CD6"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding B, Mode=TwoWay}"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="A:" Width="20" Foreground="#CCCCCC"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding A, Mode=TwoWay}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="10,30,10,10">
        <!-- Obere Menüleiste -->
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Width="50" Background="#2D2D30" Foreground="#D4D4D4" FontWeight="Bold"
                    Content="X" Click="MenuExit_Click"/>
            <Menu DockPanel.Dock="Left" Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="4,2" Width="50">
                <MenuItem Header="_Datei">
                    <MenuItem Header="_Neu" InputGestureText="Strg+N" Click="MenuNew_Click" Background="#2D2D30" Foreground="#D4D4D4" />
                    <MenuItem Header="_Öffnen..." InputGestureText="Strg+O" Click="MenuOpen_Click" Background="#2D2D30" Foreground="#D4D4D4" />
                    <Separator Background="#3F3F46" />
                    <MenuItem Header="_Speichern" InputGestureText="Strg+S" Click="MenuSave_Click" Background="#2D2D30" Foreground="#D4D4D4" />
                    <MenuItem Header="Speichern _unter..." InputGestureText="Strg+Umschalt+S" Click="MenuSaveAs_Click" Background="#2D2D30" Foreground="#D4D4D4" />
                    <Separator Background="#3F3F46" />
                    <MenuItem Header="_Beenden" Click="MenuExit_Click" Background="#2D2D30" Foreground="#D4D4D4" />
                </MenuItem>
            </Menu>
            <Button DockPanel.Dock="Left" Width="50" Background="#2D2D30" Foreground="#D4D4D4" FontWeight="Bold"
                    Content="FS" Click="MenuFullScreen_Click"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1.2*" />
                <!--
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="280" />
                -->
            </Grid.ColumnDefinitions>

            <!-- Spalte 1: ISF Code Editor & Compiler-Output -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="130" />
                </Grid.RowDefinitions>

                <avalonedit:TextEditor x:Name="CodeEditor" 
                                       FontFamily="Consolas" FontSize="13"
                                       Background="#1E1E1E" Foreground="#D4D4D4"
                                       ShowLineNumbers="True"
                                       TextChanged="CodeEditor_TextChanged" />

                <TextBox x:Name="ErrorLog" Grid.Row="1" IsReadOnly="True" 
                         Background="#252526" Foreground="#F48771" 
                         FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333333" />
            
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="360" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- OpenGL Viewport -->
                <glWpfControl:GLWpfControl x:Name="OpenGlControl" 
                           Grid.Row="0" 
                           Render="OpenGlControl_Render" />

                <GridSplitter Grid.Row="1" Width="5" HorizontalAlignment="Stretch" Background="#333333" />

                <!-- Dynamische ISF Parameter-Controls -->
                <Border Grid.Row="2" Background="#252526" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="ISF PARAMETER" FontSize="12" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,12" />
                            <ItemsControl x:Name="ParametersPanel" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
