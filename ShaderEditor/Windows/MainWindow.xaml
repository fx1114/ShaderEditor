<Window x:Class="ShaderEditor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:isf="clr-namespace:ShaderEditor.Isf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShaderEditor.Windows"
        xmlns:behaviors="clr-namespace:ShaderEditor.Behaviors"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="800" Width="1240" Background="#1E1E1E" Foreground="#D4D4D4"
        WindowStyle="None"
        behaviors:WindowBehavior.ConfirmClose="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="24" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    </Window.InputBindings>
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Template für ISF "float" -> Slider + Zahlenwert -->
        <DataTemplate DataType="{x:Type isf:FloatParameterVm}">
            <Grid Margin="0,0,0,12" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Value, StringFormat={}{0:F3}}" HorizontalAlignment="Right" Foreground="#9CDCFE" />
                    </DockPanel>
                    <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value, Mode=TwoWay}" Margin="0,4,8,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Button Content="Default" Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,2" Margin="0,0,0,3" />
                    <Button Content="Entfernen" Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,2" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Template für ISF "bool" / "event" -> CheckBox -->
        <DataTemplate DataType="{x:Type isf:BoolParameterVm}">
            <Grid Margin="0,0,0,12" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding Value, Mode=TwoWay}" Foreground="#D4D4D4" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Default" Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,2" Margin="0,0,3,0" />
                    <Button Content="Entfernen" Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,2" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Template für ISF "point2D" -> X/Y Slider -->
        <DataTemplate DataType="{x:Type isf:Point2DParameterVm}">
            <Border BorderBrush="#333333" BorderThickness="1" Padding="8" Margin="0,0,0,12" CornerRadius="4" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DockPanel>
                            <TextBlock Text="X:" Width="20" />
                            <TextBlock Text="{Binding X, StringFormat={}{0:F2}}" DockPanel.Dock="Right" Width="35" TextAlignment="Right" />
                            <Slider Minimum="{Binding MinX}" Maximum="{Binding MaxX}" Value="{Binding X, Mode=TwoWay}" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Y:" Width="20" />
                            <TextBlock Text="{Binding Y, StringFormat={}{0:F2}}" DockPanel.Dock="Right" Width="35" TextAlignment="Right" />
                            <Slider Minimum="{Binding MinY}" Maximum="{Binding MaxY}" Value="{Binding Y, Mode=TwoWay}" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button Content="Default" Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,2" Margin="0,0,0,3" />
                        <Button Content="Entfernen" Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,2" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template für ISF "color" -> RGBA Slider -->
        <DataTemplate DataType="{x:Type isf:ColorParameterVm}">
            <Border BorderBrush="#333333" BorderThickness="1" Padding="8" Margin="0,0,0,12" CornerRadius="4" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DockPanel><TextBlock Text="R:" Width="20" Foreground="#F48771"/><Slider Minimum="{Binding MinR}" Maximum="{Binding MaxR}" Value="{Binding R, Mode=TwoWay}"/></DockPanel>
                        <DockPanel><TextBlock Text="G:" Width="20" Foreground="#89D185"/><Slider Minimum="{Binding MinG}" Maximum="{Binding MaxG}" Value="{Binding G, Mode=TwoWay}"/></DockPanel>
                        <DockPanel><TextBlock Text="B:" Width="20" Foreground="#569CD6"/><Slider Minimum="{Binding MinB}" Maximum="{Binding MaxB}" Value="{Binding B, Mode=TwoWay}"/></DockPanel>
                        <DockPanel><TextBlock Text="A:" Width="20" Foreground="#CCCCCC"/><Slider Minimum="{Binding MinA}" Maximum="{Binding MaxA}" Value="{Binding A, Mode=TwoWay}"/></DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button Content="Default" Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,2" Margin="0,0,0,3" />
                        <Button Content="Entfernen" Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,2" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="10,30,10,10">
        <!-- Obere Menüleiste -->
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Width="50" Background="#2D2D30" Foreground="#D4D4D4" FontWeight="Bold"
                    Content="X" Command="{Binding ExitCommand}"/>
            <Menu DockPanel.Dock="Left" Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="4,2" Width="50">
                <MenuItem Header="_Datei">
                    <MenuItem Header="_Neu" InputGestureText="Strg+N" Command="{Binding NewCommand}" Background="#2D2D30" Foreground="#D4D4D4" />
                    <MenuItem Header="_Öffnen..." InputGestureText="Strg+O" Command="{Binding OpenCommand}" Background="#2D2D30" Foreground="#D4D4D4" />
                    <Separator Background="#3F3F46" />
                    <MenuItem Header="_Speichern" InputGestureText="Strg+S" Command="{Binding SaveCommand}" Background="#2D2D30" Foreground="#D4D4D4" />
                    <MenuItem Header="Speichern _unter..." InputGestureText="Strg+Umschalt+S" Command="{Binding SaveAsCommand}" Background="#2D2D30" Foreground="#D4D4D4" />
                    <Separator Background="#3F3F46" />
                    <MenuItem Header="_Beenden" Command="{Binding ExitCommand}" Background="#2D2D30" Foreground="#D4D4D4" />
                </MenuItem>
            </Menu>
            <Button DockPanel.Dock="Left" Width="50" Background="#2D2D30" Foreground="#D4D4D4" FontWeight="Bold"
                    Content="FS" Command="{Binding FullscreenCommand}"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,6,0,6">
            <Button DockPanel.Dock="Right" Width="110" Content="Ordner wählen..."
                    Background="#2D2D30" Foreground="#D4D4D4" Command="{Binding SelectFolderCommand}" />
            <TextBox Text="{Binding ShaderFolderPath, Mode=OneWay}" IsReadOnly="True"
                     Background="#252526" Foreground="#D4D4D4" BorderBrush="#3F3F46"
                     VerticalContentAlignment="Center" Padding="6,0" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- Shader-Explorer -->
            <Border Grid.Column="0" Background="#252526" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SHADER" FontSize="12" FontWeight="Bold"
                               Foreground="#888888" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding ShaderFiles}" SelectedItem="{Binding SelectedShader, Mode=TwoWay}"
                             Background="#252526" Foreground="#D4D4D4" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="×" Width="24" Height="24"
                                                Padding="0" Margin="4,0,0,0"
                                                Background="#3A3A3D" Foreground="#D4D4D4"
                                                BorderBrush="#555555"
                                                ToolTip="Datei löschen"
                                                Command="{Binding DataContext.DeleteShaderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding FileName}" Padding="4,6" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333333" />

            <!-- ISF Code Editor & Compiler-Output -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="130" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" Background="#1E1E1E" Foreground="#D4D4D4">
                    <TabItem Header="Fragment-Shader" Background="#2D2D30" Foreground="#D4D4D4">
                        <avalonedit:TextEditor behaviors:AvalonEditBehavior.IsEnabled="True"
                                               behaviors:AvalonEditBehavior.HoverToken="{Binding FragmentHoverToken, Mode=TwoWay}"
                                               behaviors:AvalonEditBehavior.Text="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               FontFamily="Consolas" FontSize="13"
                                               Background="#1E1E1E" Foreground="#D4D4D4"
                                               ShowLineNumbers="True" />
                    </TabItem>
                    <TabItem Background="#2D2D30" Foreground="#D4D4D4">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding CreateVertexShader, Mode=TwoWay}" 
                                          Foreground="#D4D4D4" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="Vertex-Shader" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <avalonedit:TextEditor behaviors:AvalonEditBehavior.IsEnabled="True"
                                               behaviors:AvalonEditBehavior.HoverToken="{Binding VertexHoverToken, Mode=TwoWay}"
                                               behaviors:AvalonEditBehavior.Text="{Binding VertexEditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               FontFamily="Consolas" FontSize="13"
                                               Background="#1E1E1E" Foreground="#D4D4D4"
                                               ShowLineNumbers="True" />
                    </TabItem>
                </TabControl>

                <TextBox Grid.Row="1" Text="{Binding ErrorLog, Mode=OneWay}" IsReadOnly="True" 
                         Background="#252526" Foreground="#F48771" 
                         FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#333333" />
            
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90" />
                    <RowDefinition Height="360" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <local:GpuTimeGraph Grid.Row="0" Samples="{Binding GpuRenderTimes}" />

                <!-- OpenGL Viewport -->
                <glWpfControl:GLWpfControl Grid.Row="1" x:Name="OpenGlControl" />

                <GridSplitter Grid.Row="2" Width="5" HorizontalAlignment="Stretch" Background="#333333" />

                <!-- Dynamische ISF Parameter-Controls -->
                <Border Grid.Row="3" Background="#252526" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Hover-Ausdruck" Foreground="#D4D4D4" Margin="0,0,0,4" />
                            <TextBox Text="{Binding HoverExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="GLSL-Ausdruck, der während des Mouse-Hovers eingesetzt wird"
                                     Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#3F3F46"
                                     Padding="5,3" Margin="0,0,0,12" />
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="Neu" Command="{Binding NewParameterCommand}"
                                        Padding="10,3" Background="#2D2D30" Foreground="#D4D4D4" />
                                <TextBlock Text="ISF PARAMETER" FontSize="12" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Parameters}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
